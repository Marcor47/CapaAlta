  m_Script: {fileID: 11500000, guid: 5fc396f4914b5df4bb95f8426f6fd7cb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TelefonoTool
  minWait: 2
  maxWait: 4
  answerChance: 0.5
  callCooldown: 6
  dotsInterval: 0.35
  dotsRoot: {fileID: 6067191436404189248}
  dotsText: {fileID: 2410329818767544193}
  noAnswerText: Llamada perdida
  cooldownText: "Sin se\xF1al por ahora..."
  tempMessageSeconds: 1.5
  speakerName: "Mam\xE1"
  momComments:
  - "Si sigues intentando, ning\xFAn obst\xE1culo te detendr\xE1."
  - "T\xF3mate tu tiempo para apreciar lo que tienes en el camino, Theo."
  - "Respira hondo. Lo est\xE1s haciendo mejor de lo que crees."
  - "No tienes que apurarte, el camino sigue aqu\xED."
  - "Me alegra o\xEDrte, Theo. Sigue a tu ritmo."
  - "Si te cansas, si\xE9ntate un momento. Eso tambi\xE9n es avanzar."
  - "Estoy orgullosa de ti, \xBFlo sab\xEDas?"
  - "Cada paso cuenta, aunque sea peque\xF1o."
  - "Recuerda a d\xF3nde quieres llegar."
  - Escucha lo que sientes, no hay nada malo en eso.
  - "Pase lo que pase, aqu\xED estoy para ti."
  - Un poco de agua y un buen respiro, y sigues.
  linesPerCall: 1
