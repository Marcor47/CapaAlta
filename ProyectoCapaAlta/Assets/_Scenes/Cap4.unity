  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ToolUnlockCall
  toolToUnlock: 5
  speakerName: "Mam\xE1"
  callLines:
  - speakerName: 
    text: "Hijo, ya est\xE1s muy cerca."
  - speakerName: 
    text: "En el \xFAltimo cierre a la derecha puse un regalo m\xE1s."
  - speakerName: 
    text: Son unos pinchos de hielo o piolets.
  - speakerName: 
    text: "Eng\xE1nchate de las paredes con agujeros pronunciados para treparlos."
  - speakerName: 
    text: "Ser\xE1 m\xE1s seguro con los pinchos."
  - speakerName: 
    text: "Suerte hijo, t\xFA puedes."
  ringAgainIfAlreadyUnlocked: 1
  replayCallLines: []
  ringingPromptUI: {fileID: 349891246}
  unlockedToastUI: {fileID: 155776343}
  toastSeconds: 3
  ringGap: 0.2
  ringRepeatEvery: 2
