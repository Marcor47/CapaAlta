  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ToolUnlockCall
  toolToUnlock: 3
  speakerName: "Mam\xE1"
  callLines:
  - speakerName: 
    text: Theo, soy yo.
  - speakerName: 
    text: "Te peguntar\xE1s que m\xE1s hay en tu mochila."
  - speakerName: 
    text: "Los compartimientos lo dise\xF1\xE9 yo misma."
  - speakerName: 
    text: "En el pen\xFAltimo a la izquierda encontrar\xE1s una onda."
  - speakerName: 
    text: "Si es que encuentras ramas secas que puedan estar estorb\xE1ndote en el
      camino puede tirarlas abajo con unas piedritas."
  - speakerName: 
    text: O solo puedes jugar con ellas, responsablemento eso si, hijo.
  ringingPromptUI: {fileID: 349891246}
  unlockedToastUI: {fileID: 0}
  toastSeconds: 3
  ringtone: {fileID: 0}
