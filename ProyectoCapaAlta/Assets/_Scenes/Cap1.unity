  m_Script: {fileID: 11500000, guid: 30128d1ed79ad224ea64586ba24146cb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ToolUnlockCall
  toolToUnlock: 6
  speakerName: "Mam\xE1"
  callLines:
  - speakerName: 
    text: "\xA1Theo!"
  - speakerName: 
    text: "No quer\xEDa arruinarte la sorpresa pero..."
  - speakerName: 
    text: "Es posible que experimentes cosas... extra\xF1as en el camino a la monta\xF1a."
  - speakerName: 
    text: "Tu pap\xE1 era muy... especial. Siempre me hablaba de la cultura de su
      pueblo."
  - speakerName: 
    text: "Su pueblo tiene un v\xEDnculo con la monta\xF1a, no me sorprender\xEDa
      que lo heredaras."
  - speakerName: 
    text: "Mientras seas valiente y honesto, la monta\xF1a cuidar\xE1 de ti."
  - speakerName: 
    text: "Te quiero, hijo. Hablamos m\xE1s adelante."
  ringAgainIfAlreadyUnlocked: 1
  replayCallLines: []
  ringingPromptUI: {fileID: 349891246}
  unlockedToastUI: {fileID: 155776343}
  toastSeconds: 3
  ringGap: 0.2
  ringRepeatEvery: 2
