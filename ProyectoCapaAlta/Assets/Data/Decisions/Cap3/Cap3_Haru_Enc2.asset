%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d6edfb0cc82e72348988115f5216b241, type: 3}
  m_Name: Cap3_Haru_Enc2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueNode
  nodeID: Cap3_Haru_Enc2
  npcName: Haru
  chapter: 3
  npcID: haru
  isSingleSpeaker: 1
  rounds:
  - conditionalOpenings:
    - requiredRelationship: 1
      npcLeadInLines:
      - speakerName: 
        text: "\xA1Azuul!"
      - speakerName: 
        text: Te tomaste una ruta larga, me parece.
      - speakerName: 
        text: "Pens\xE9 que ya no podr\xEDa verte de nuevo."
    - requiredRelationship: 0
      npcLeadInLines:
      - speakerName: 
        text: "Oh, \xBFeres t\xFA, Azul?"
      - speakerName: 
        text: "\xA1Qu\xE9 bien que nos encontramos!"
      - speakerName: 
        text: Ya estoy cerca de completar mi ruta.
    - requiredRelationship: -1
      npcLeadInLines:
      - speakerName: 
        text: Hey, Azul.
      - speakerName: 
        text: "\xBFC\xF3mo ha estado la ruta? Se ve que ha sido terrible."
      - speakerName: 
        text: "Qu\xE9 mal que se nos est\xE9 acabando el tiempo."
    npcLeadInLines:
    - speakerName: 
      text: "Estoy tomando ya las \xFAltimas fotos que ten\xEDa planeadas."
    - speakerName: 
      text: "Se oscurece y no creo que vaya a avanzar m\xE1s."
    - speakerName: 
      text: "\xBFT\xFA tambi\xE9n seguir\xE1s subiendo, no es as\xED?"
    options:
    - optionText: "A\xFAn tengo que completar mi misi\xF3n; me gustar\xEDa quedarme,
        pero no puedo."
      relationshipDelta: 1
      npcResponseLines:
      - speakerName: 
        text: "Lo s\xE9, Azul."
      - speakerName: 
        text: "Me hubiese gustado poder pasar m\xE1s tiempo."
      - speakerName: 
        text: "Pero as\xED es la vida a veces."
    - optionText: "Hay mucho en juego si no subo esta monta\xF1a."
      relationshipDelta: -1
      npcResponseLines:
      - speakerName: 
        text: Entiendo, Azul.
      - speakerName: 
        text: Creo que es algo que tienes que hacer por tu cuenta.
      - speakerName: 
        text: "Pero no siempre tienes que estar solo, \xBFs\xED?"
    - optionText: Tengo algo importante que cumplir primero, Haru.
      relationshipDelta: 0
      npcResponseLines:
      - speakerName: 
        text: Entiendo que es importante, Azul.
      - speakerName: 
        text: "Solo procura regresar de tu misi\xF3n a salvo."
      - speakerName: 
        text: "No te pierdas por ning\xFAn motivo."
    sharedFollowUpLines:
    - speakerName: 
      text: "Bueno, creo que hasta aqu\xED llego yo, Azul."
    - speakerName: 
      text: "Ya consegu\xED las fotos que quer\xEDa, as\xED que este es un buen punto
        para parar."
    - speakerName: 
      text: Fue bueno tener a alguien cerca en el camino.
  - conditionalOpenings: []
    npcLeadInLines: []
    options:
    - optionText: "Te encontrar\xE9 de nuevo cuando regrese."
      relationshipDelta: 1
      npcResponseLines:
      - speakerName: 
        text: "Qui\xE9n sabe qu\xE9 pase, Azul."
      - speakerName: 
        text: "Capaz esta es la \xFAltima vez que nos vemos."
      - speakerName: 
        text: "Pero eso est\xE1 bien."
    - optionText: "\xBFEso significa que ya no nos volveremos a ver?"
      relationshipDelta: -1
      npcResponseLines:
      - speakerName: 
        text: Azul, tienes cosas que resolver.
      - speakerName: 
        text: "Capaz nos encontramos por alguna raz\xF3n en el camino."
      - speakerName: 
        text: "Y vali\xF3 la pena."
    - optionText: "\xBFNos volveremos a ver?"
      relationshipDelta: 0
      npcResponseLines:
      - speakerName: 
        text: "Lo que tenga que pasar, pasar\xE1, Azul."
      - speakerName: 
        text: Tuvimos la suerte de coincidir en el camino.
      - speakerName: 
        text: Capaz sea por algo.
    sharedFollowUpLines:
    - speakerName: 
      text: Los momentos no necesitan ser eternos para haber valido la pena.
    - speakerName: 
      text: "Cu\xEDdate mucho, Azul."
  givesManzanaOnEnd: 0
  manzanaTutorialLines: []
  manzanaGivenWhenBad: []
  manzanaGivenWhenNeutral: []
  manzanaGivenWhenGood: []
