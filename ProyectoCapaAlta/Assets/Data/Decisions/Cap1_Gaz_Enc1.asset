  m_Script: {fileID: 11500000, guid: d6edfb0cc82e72348988115f5216b241, type: 3}
  m_Name: Cap1_Gaz_Enc1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueNode
  nodeID: gaz_cap1_enc1
  npcName: Gaz
  chapter: 1
  openingLines:
  - "\xA1Hey! No tan r\xE1pido..."
  - "\xBFTambi\xE9n est\xE1s subiendo hasta la cima?"
  - "Dicen que esta monta\xF1a es de las m\xE1s dif\xEDciles de la regi\xF3n, chico."
  - "M\xE1s te vale estar preparado."
  options:
  - optionText: "Vengo por un tema personal, en la cima. \xBFY t\xFA?"
    relationshipDelta: 1
    npcResponseLines:
    - Hey, somos dos entonces, chico.
    - "He escalado muchas monta\xF1as pero este es mi reto definitivo."
    - "Termino de ordenar mis provisiones y retomar\xE9 el ritmo, nos vemos en la
      cima."
    closingLines: []
  - optionText: "S\xED, creo que soy el m\xE1s preparado para esto la verdad."
    relationshipDelta: -1
    npcResponseLines:
    - "Con que el m\xE1s preparado. Mucha confianza te tienes, chico."
    - "He entrenado con varias monta\xF1as tan grandes como esta antes."
    - "Termino de ordenar mis provisiones y retomar\xE9 el ritmo, veremos qui\xE9n
      llega antes a la cima."
    closingLines: []
  - optionText: "Creo que lo estoy, nunca hab\xEDa subido algo as\xED."
    relationshipDelta: 0
    npcResponseLines:
    - Tranquilo, chico.
    - Esto se ve peor de lo que parece, eso creo.
    - "Termino de ordenar mis provisiones y retomar\xE9 el ritmo, estoy seguro que
      nos veremos en la cima."
    closingLines: []
  givesManzanaOnEnd: 0
  manzanaTutorialLines: []
  npcID: gaz
