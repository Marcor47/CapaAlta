  m_Script: {fileID: 11500000, guid: 0cc89f5f6e2ef6140828ac636dfc815e, type: 3}
  m_Name: Cap3_Padre_03
  m_EditorClassIdentifier: Assembly-CSharp::CardData
  cardID: Padre_03
  authorName: Jason
  cardType: 0
  chapter: 3
  cardText: "Dejaste una taza en la repisa y no me animo a guardarla. Cada ma\xF1ana
    sirvo t\xE9 para dos por costumbre y me lo tomo solo, mirando la puerta. Para
    ti el mundo era peque\xF1o, y yo ya ten\xEDa todo mi mundo aqu\xED conmigo, quiz\xE1
    por eso nos quisimos tanto. Te extra\xF1o en cada rinc\xF3n de esta casa y en
    cada amanecer de esta monta\xF1a. Ojal\xE1 est\xE9s bien, mi querida Mely."
  theoReactionLines:
  - "T\xE9 para dos, todas las ma\xF1anas\u2026"
  - "A mam\xE1 le gustar\xEDa mucho leer esto."
  - "Ella tambi\xE9n te extra\xF1a, pap\xE1."
  cardSprite: {fileID: 21300000, guid: d1e074bfca74f7f4eb852f9fb0c46f92, type: 3}
  babbleAudio: {fileID: 0}
