  m_Script: {fileID: 11500000, guid: 0cc89f5f6e2ef6140828ac636dfc815e, type: 3}
  m_Name: Cap3_Mely_01
  m_EditorClassIdentifier: Assembly-CSharp::CardData
  cardID: Mely_01
  authorName: Mely
  cardType: 1
  chapter: 3
  cardText: "La maleta est\xE1 lista desde ayer y a\xFAn no la cierro. Me encanta
    esta monta\xF1a, y t\xFA a\xFAn m\xE1s. S\xE9 que lo hablamos y quedamos de acuerdo
    en que Theo merece un mundo m\xE1s grande para elegir su propio camino. Pero
    cuando se durmi\xF3 en mi hombro me pregunt\xE9, \xBFy si de verdad no vienes?
    Una parte de m\xED sigue esperando que cambies de idea. Te amo, y eso no se va
    a ir con la distancia, mi querido Jason."
  theoReactionLines:
  - "\xBFMely?"
  - "Mam\xE1\u2026"
  - "Pudiste haberte quedado tambi\xE9n."
  - "Aunque si lo hubieras hecho, nunca habr\xEDa podido conocer y vivir tanto."
  - "Pero la felicidad de ustedes tambi\xE9n importa."
  cardSprite: {fileID: 21300000, guid: 0f62e51aff50ddd409c524747f8bb435, type: 3}
  babbleAudio: {fileID: 0}
